# ===== الإعدادات العامة (Local) — انسخه إلى `.env` وعدّله =====

# ---------- وضع قاعدة البيانات ----------
# local  → يعمل بدون أي خدمات خارجية (sqlite محلي) تجريبياً
# supabase → يتصل بـ Supabase الحقيقي (PostgreSQL + Auth)
DB_MODE=local

# ---------- Supabase (المطلوب في وضع supabase) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ---------- قيود البحث ----------
SEARCH_LIMIT_DAILY=4        # البحوث المجانية اليومية
PRO_DURATION_DAYS=30        # مدة اشتراك البرو
TOKEN_SECRET=change-me-please

# ---------- أدمن محلي (في وضع local) ----------
ADMIN_USERNAME=kalilax
ADMIN_PASSWORD=kalilax122313

# ---------- الأدوات (تُحاول التحقق من وجودها، وتتجاوز الغائب) ----------
MAIGRET_BIN=maigret
HOLEHE_BIN=holehe
PHONEINFOGA_BIN=phoneinfoga